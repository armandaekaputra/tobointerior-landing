---
import Base from '../layouts/Base.astro';
import WaButton from '../components/WaButton.astro';

const parkRegisRooms = [
  {
    nama: 'Lobi & Resepsionis',
    before: ['parkregis-lobi-before-1', 'parkregis-lobi-before-2'],
    after: ['parkregis-lobi-after-1', 'parkregis-lobi-after-2', 'parkregis-lobi-after-3'],
  },
  {
    nama: 'Ruang Meeting 1',
    before: ['parkregis-meeting1-before-1'],
    after: ['parkregis-meeting1-after-1', 'parkregis-meeting1-after-2'],
  },
  {
    nama: 'Ruang Meeting 2',
    before: ['parkregis-meeting2-before-1'],
    after: ['parkregis-meeting2-after-1', 'parkregis-meeting2-after-2'],
  },
  {
    nama: 'Ruang Direktur',
    before: ['parkregis-direktur-before-1'],
    after: ['parkregis-direktur-after-1', 'parkregis-direktur-after-2'],
  },
  {
    nama: 'Detail & Furnitur Built-in',
    before: ['parkregis-item-before-1', 'parkregis-item-before-2'],
    after: ['parkregis-item-after-1', 'parkregis-item-after-2'],
  },
];

const gridColsClass = (n: number) =>
  n >= 3 ? 'sm:grid-cols-3' : n === 2 ? 'sm:grid-cols-2' : 'max-w-sm';

const masalah = [
  {
    judul: 'Tidak tahu apa yang terjadi di lokasi',
    isi: 'Progres hanya diketahui saat sempat datang. Sisanya menebak.',
  },
  {
    judul: 'Biaya berubah di tengah jalan',
    isi: 'Penawaran awal terlihat murah, lalu muncul tambahan yang tidak pernah dibahas.',
  },
  {
    judul: 'Tidak jelas siapa yang bertanggung jawab',
    isi: 'Saat ada masalah, tukang menunjuk mandor, mandor menunjuk vendor.',
  },
  {
    judul: 'Operasional terganggu lebih lama dari perkiraan',
    isi: 'Jadwal meleset, ruang belum bisa dipakai, aktivitas kerja ikut tertahan.',
  },
];

const tahapan = [
  {
    n: '01',
    judul: 'Survey & Pengukuran',
    isi: 'Kami datang ke lokasi, mengukur, dan memeriksa kondisi ruang sebelum bicara angka.',
  },
  {
    n: '02',
    judul: 'Layout 2D dan 3D',
    isi: 'Anda melihat rencana ruang sebelum pekerjaan dimulai, bukan membayangkannya.',
  },
  {
    n: '03',
    judul: 'RAB dan AHS',
    isi: 'Anggaran disusun per item pekerjaan, lengkap dengan analisa harga satuan. Anda bisa melihat harga itu terbentuk dari apa.',
  },
  {
    n: '04',
    judul: 'Surat Penawaran Harga',
    isi: 'Penawaran resmi dan tertulis. Bukan perkiraan lisan.',
  },
  {
    n: '05',
    judul: 'Negosiasi dan Kesepakatan',
    isi: 'Anda dapat menyesuaikan lingkup atau spesifikasi sebelum menyetujui.',
  },
  {
    n: '06',
    judul: 'Pengawasan Berlapis',
    isi: 'Tukang dan asisten diawasi mandor. Mandor diawasi Project Manager. Ada penanggung jawab di setiap lapisan.',
    tandai: true,
  },
  {
    n: '07',
    judul: 'Dokumentasi Progres Harian',
    isi: 'Project Manager memperbarui folder berisi foto dan keterangan setiap hari kerja. Anda bisa membukanya kapan saja, dari mana saja.',
    tandai: true,
  },
  {
    n: '08',
    judul: 'QC Internal, lalu QC Anda',
    isi: 'Tim kami memeriksa hasil lebih dulu. Setelah itu giliran Anda. Bila ada yang perlu diperbaiki, kami bereskan.',
  },
  {
    n: '09',
    judul: 'Laporan, BAST, baru Penagihan',
    isi: 'Kami menagih setelah Anda menyetujui hasil pekerjaan.',
    tandai: true,
  },
];

// Contoh isi log. Ganti dengan potongan log proyek asli.
const log = [
  { hari: 'Hari 01', tgl: '03 Mar', ket: 'Pembongkaran partisi lama, proteksi area', n: 8 },
  { hari: 'Hari 02', tgl: '04 Mar', ket: 'Marking layout, pemasangan rangka partisi', n: 11 },
  { hari: 'Hari 03', tgl: '05 Mar', ket: 'Instalasi titik listrik dan data', n: 6 },
  { hari: 'Hari 04', tgl: '06 Mar', ket: 'Penutupan gypsum, compound tahap satu', n: 9 },
  { hari: 'Hari 05', tgl: '07 Mar', ket: 'Rangka plafon, pemeriksaan elevasi', n: 7 },
];

const faq = [
  {
    q: 'Berapa kisaran biaya renovasi kantor?',
    a: 'Biaya bergantung pada luas ruang, lingkup pekerjaan, dan spesifikasi material. Kami tidak memberikan angka sebelum survei, karena perkiraan tanpa pengukuran hampir selalu meleset. Setelah survei, Anda menerima RAB per item pekerjaan beserta analisa harga satuannya.',
  },
  {
    q: 'Berapa lama pengerjaannya?',
    a: 'Lama pengerjaan tergantung luas ruang dan tingkat kesulitan teknis. Sebagai gambaran, proyek dengan anggaran Rp100–200 juta umumnya berkisar 2–3 bulan.',
  },
  {
    q: 'Siapa yang mengawasi pekerjaan di lokasi?',
    a: 'Setiap proyek memiliki mandor di lapangan dan Project Manager yang mengawasi mandor. Project Manager juga menjadi penanggung jawab komunikasi dengan Anda.',
  },
  {
    q: 'Bagaimana saya tahu progres tanpa harus datang?',
    a: 'Project Manager memperbarui folder dokumentasi setiap hari kerja, berisi foto dan keterangan pekerjaan. Anda mendapat akses dan bisa membukanya kapan saja.',
  },
  {
    q: 'Bagaimana kalau ada perubahan di tengah proyek?',
    a: 'Perubahan dibahas terlebih dahulu, lalu dihitung ulang dan disampaikan tertulis sebelum dikerjakan. Tidak ada pekerjaan tambahan yang muncul di tagihan tanpa persetujuan Anda.',
  },
  {
    q: 'Bagaimana sistem pembayarannya?',
    a: 'Pembayaran dilakukan dalam 4 termin: DP/Termin 1 sebesar 30% di awal, Termin 2 sebesar 40% saat progres mencapai 50%, Termin 3 sebesar 20% saat progres mencapai 80%, dan Termin 4/pelunasan sebesar 10% setelah progres 100% dan Anda menandatangani berita acara serah terima.',
  },
  {
    q: 'Apakah menerima pekerjaan furnitur satuan?',
    a: 'Fokus kami adalah renovasi ruang secara menyeluruh. Untuk kebutuhan furnitur satuan, kami sarankan mencari workshop furnitur yang lebih sesuai.',
  },
];
---

<Base>
  <!-- ══════════ HERO ══════════ -->
  <header class="border-b border-line">
    <div class="wrap flex items-center justify-between py-5">
      <span class="flex items-center gap-2 font-display font-extrabold tracking-tight text-lg">
        <img src="/images/logo-icon.png" alt="" width="28" height="30" class="h-[30px] w-auto" />
        TOBO<span class="text-brass">INTERIOR</span>
      </span>
      <span class="hidden font-mono text-xs tracking-widest uppercase text-graphite sm:block">
        Jakarta Selatan &middot; Tangerang Selatan
      </span>
    </div>
  </header>

  <section class="band">
    <div class="wrap grid gap-14 lg:grid-cols-[1.05fr_1fr] lg:items-center lg:gap-16">
      <div>
        <p class="eyebrow">Renovasi Interior Kantor &amp; Ruang Komersial</p>

        <h1 class="text-[2.6rem] leading-[1.05] sm:text-6xl">
          Renovasi interior kantor<br />
          yang bisa Anda pantau<br />
          <span class="text-brass">setiap hari.</span>
        </h1>

        <p class="mt-7 max-w-xl text-lg text-graphite">
          Kami mengerjakan renovasi ruang kantor dan komersial di Jakarta Selatan
          dan Tangerang Selatan — dengan standar kerja yang sama seperti proyek
          instansi yang kami tangani.
        </p>

        <div class="mt-9">
          <WaButton location="hero" />
          <p class="mt-4 font-mono text-xs tracking-wide text-graphite">
            Kami akan menanyakan lokasi, jenis ruang, dan perkiraan luas terlebih dahulu.
          </p>
        </div>
      </div>

      <img
        src="/images/hero-tanah-kusir.jpg"
        alt="Hasil renovasi ruang meeting kantor Tanah Kusir oleh TOBO Interior"
        width="1400"
        height="1750"
        class="aspect-[4/5] w-full object-cover"
      />
    </div>
  </section>

  <!-- ══════════ KREDIBILITAS ══════════ -->
  <section class="border-y border-line bg-concrete">
    <div class="wrap grid gap-10 py-14 md:grid-cols-[1.2fr_1fr] md:items-center">
      <div>
        <h2 class="text-2xl sm:text-3xl">
          Dipercaya mengerjakan proyek dengan pengawasan ketat
        </h2>
        <p class="mt-4 max-w-lg text-graphite">
          Kami terbiasa bekerja di lingkungan proyek yang menuntut kelengkapan
          administrasi, ketepatan spesifikasi, dan pengawasan berlapis. Standar
          itu yang kami bawa ke setiap proyek swasta.
        </p>
      </div>

      <ul class="space-y-3 font-mono text-sm text-ink">
        <li class="flex gap-3 border-b border-line pb-3">
          <span class="text-brass">&mdash;</span>
          Kementerian Agama Republik Indonesia
        </li>
        <li class="flex gap-3 border-b border-line pb-3">
          <span class="text-brass">&mdash;</span>
          UIN Syarif Hidayatullah Jakarta
        </li>
        <li class="flex gap-3 text-graphite">
          <span class="text-brass">&mdash;</span>
          Nilai proyek institusi tersebut Rp 100&ndash;300 juta
        </li>
      </ul>
    </div>
  </section>

  <!-- ══════════ MASALAH ══════════ -->
  <section class="band">
    <div class="wrap">
      <p class="eyebrow">Yang sering terjadi</p>

      <h2 class="max-w-2xl text-3xl sm:text-4xl">
        Sebagian besar masalah renovasi bukan soal kemampuan teknis
      </h2>
      <p class="mt-5 max-w-xl text-lg text-graphite">
        Masalahnya hampir selalu datang dari proses yang tidak jelas.
      </p>

      <div class="mt-12 grid gap-px border border-line bg-line sm:grid-cols-2">
        {masalah.map((m) => (
          <div class="bg-paper p-7">
            <h3 class="text-lg">{m.judul}</h3>
            <p class="mt-2.5 text-graphite">{m.isi}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════ SISTEM KERJA ══════════ -->
  <section class="band border-t border-line bg-concrete">
    <div class="wrap">
      <p class="eyebrow">Cara kami bekerja</p>

      <div class="grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
        <h2 class="max-w-2xl text-3xl sm:text-4xl">
          Sembilan tahap, dari pengukuran sampai penagihan
        </h2>
        <p class="max-w-sm text-graphite">
          Setiap proyek berjalan melalui tahapan yang sama. Anda tahu posisi
          proyek Anda kapan pun.
        </p>
      </div>

      <ol class="mt-14 border-t border-line">
        {tahapan.map((t) => (
          <li class="grid gap-x-8 gap-y-2 border-b border-line py-6 sm:grid-cols-[4rem_14rem_1fr] sm:py-7">
            <span class="font-mono text-sm text-brass">{t.n}</span>
            <h3 class="text-lg leading-snug">
              {t.judul}
              {t.tandai && (
                <span class="ml-2 align-middle font-mono text-[0.62rem] uppercase tracking-widest text-brass">
                  &#9679; pembeda
                </span>
              )}
            </h3>
            <p class="text-graphite">{t.isi}</p>
          </li>
        ))}
      </ol>

      <p class="mt-8 max-w-2xl text-graphite">
        Tahap 07 dan 09 adalah bagian yang paling sering ditanyakan klien.
        Keduanya kami jalankan di setiap proyek.
      </p>
    </div>
  </section>

  <!-- ══════════ BUKTI PROSES — elemen utama ══════════ -->
  <section class="band">
    <div class="wrap">
      <p class="eyebrow">Bukti proses</p>

      <div class="grid gap-12 lg:grid-cols-[1fr_1.15fr] lg:gap-16">
        <div>
          <h2 class="text-3xl sm:text-4xl">
            Seperti ini bentuk laporan yang Anda terima
          </h2>
          <p class="mt-5 text-lg text-graphite">
            Setiap proyek memiliki folder dokumentasi sendiri. Project Manager
            memperbaruinya setiap hari kerja — foto kondisi terkini beserta
            keterangan pekerjaan.
          </p>
          <p class="mt-4 text-lg text-graphite">
            Anda tidak perlu bertanya untuk tahu progres.
          </p>

          <figure class="mt-8 aspect-[16/10] w-full overflow-hidden border border-line">
            <img
              src="/images/doc-log.jpg"
              alt="Contoh log dokumentasi progres harian proyek Tanah Kusir"
              width="1600"
              height="1000"
              class="h-full w-full object-cover object-top"
            />
          </figure>
        </div>

        <!-- Log dokumentasi -->
        <div class="border border-line bg-concrete">
          <div class="flex items-center justify-between border-b border-line px-5 py-3.5">
            <span class="font-mono text-xs uppercase tracking-widest text-graphite">
              Log Dokumentasi Proyek
            </span>
            <span class="font-mono text-xs text-brass">contoh</span>
          </div>

          <ul>
            {log.map((l) => (
              <li class="grid grid-cols-[auto_1fr_auto] items-center gap-4 border-b border-line px-5 py-4">
                <div class="font-mono text-xs leading-tight">
                  <div class="text-ink">{l.hari}</div>
                  <div class="text-graphite">{l.tgl}</div>
                </div>
                <p class="text-sm leading-snug text-graphite">{l.ket}</p>
                <span class="font-mono text-xs whitespace-nowrap text-brass">
                  {l.n} foto
                </span>
              </li>
            ))}
          </ul>

          <p class="px-5 py-4 font-mono text-xs leading-relaxed text-graphite">
            Diperbarui setiap hari kerja oleh Project Manager.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════ CASE STUDY ══════════ -->
  <section class="band border-y border-line bg-concrete">
    <div class="wrap">
      <p class="eyebrow">Studi kasus</p>

      <h2 class="text-3xl sm:text-4xl">
        Renovasi interior kantor — Park Regis by Prince Hotel, Menteng
      </h2>
      <p class="mt-5 max-w-xl text-lg text-graphite">
        Ruang kantor swasta di gedung Park Regis by Prince Hotel — meliputi
        lobi resepsionis, dua ruang meeting, ruang direktur, hingga detail
        furnitur built-in.
      </p>

      {parkRegisRooms.map((room) => (
        <div class="mt-14 border-t border-line pt-10 first:mt-10">
          <h3 class="text-xl font-semibold">{room.nama}</h3>

          <div class="mt-6">
            <p class="font-mono text-xs uppercase tracking-widest text-brass">Sebelum</p>
            <div class={`mt-3 grid gap-4 ${gridColsClass(room.before.length)}`}>
              {room.before.map((src) => (
                <figure class="aspect-[4/3] overflow-hidden">
                  <img
                    src={`/images/${src}.jpg`}
                    alt={`Kondisi ${room.nama} sebelum direnovasi — proyek Park Regis by Prince Hotel`}
                    width="1200"
                    height="900"
                    loading="lazy"
                    class="h-full w-full object-cover"
                  />
                </figure>
              ))}
            </div>
          </div>

          <div class="mt-6">
            <p class="font-mono text-xs uppercase tracking-widest text-brass">Sesudah</p>
            <div class={`mt-3 grid gap-4 ${gridColsClass(room.after.length)}`}>
              {room.after.map((src) => (
                <figure class="aspect-[4/3] overflow-hidden">
                  <img
                    src={`/images/${src}.jpg`}
                    alt={`Hasil akhir ${room.nama} setelah direnovasi — proyek Park Regis by Prince Hotel`}
                    width="1200"
                    height="900"
                    loading="lazy"
                    class="h-full w-full object-cover"
                  />
                </figure>
              ))}
            </div>
          </div>
        </div>
      ))}

      <blockquote class="mt-14 max-w-3xl border-l-2 border-brass py-1 pl-6">
        <p class="text-lg text-graphite">
          &ldquo;Kali ini skalanya lebih besar — lobi, dua ruang meeting,
          sampai ruang direktur, semua jalan bersamaan. Saya tetap bisa
          pantau tiap ruangan dari laporan harian, jadi tidak ada yang luput
          meski banyak titik pekerjaan sekaligus.&rdquo;
        </p>
        <footer class="mt-4 font-mono text-xs uppercase tracking-widest text-graphite">
          — ERPS, klien Renovasi Kantor Park Regis by Prince Hotel
        </footer>
      </blockquote>
    </div>
  </section>

  <!-- ══════════ CASE STUDY 2 ══════════ -->
  <section class="band border-b border-line bg-concrete">
    <div class="wrap">
      <p class="eyebrow">Studi kasus</p>

      <h2 class="text-3xl sm:text-4xl">
        Renovasi ruang kantor — Tanah Kusir, Jakarta Selatan
      </h2>

      <div class="mt-10">
        <p class="font-mono text-xs uppercase tracking-widest text-brass">Sebelum</p>
        <div class="mt-3 grid gap-4 sm:grid-cols-3">
          {['case-before-1', 'case-before-2', 'case-before-3'].map((src) => (
            <figure class="aspect-[4/3] overflow-hidden">
              <img
                src={`/images/${src}.jpg`}
                alt="Kondisi ruang sebelum direnovasi — proyek Tanah Kusir"
                width="1200"
                height="900"
                loading="lazy"
                class="h-full w-full object-cover"
              />
            </figure>
          ))}
        </div>
      </div>

      <div class="mt-8">
        <p class="font-mono text-xs uppercase tracking-widest text-brass">Sesudah</p>
        <div class="mt-3 grid gap-4 sm:grid-cols-3">
          {['case-after-1', 'case-after-2', 'case-after-3'].map((src) => (
            <figure class="aspect-[4/3] overflow-hidden">
              <img
                src={`/images/${src}.jpg`}
                alt="Hasil akhir ruang kerja setelah direnovasi — proyek Tanah Kusir"
                width="1200"
                height="901"
                loading="lazy"
                class="h-full w-full object-cover"
              />
            </figure>
          ))}
        </div>
      </div>

      <div class="mt-10 grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
        {[
          {
            h: 'Kondisi awal',
            isi: 'Dua ruang kamar tidur dan satu ruang yang difungsikan sebagai gudang.',
          },
          {
            h: 'Kebutuhan klien',
            isi: 'Diubah menjadi 2 ruang kerja dengan 1 ruang meeting sebagai penghubung di antara keduanya. Setiap ruang kerja punya toilet sendiri; toilet di area meeting dibongkar untuk memperluas ruangan.',
          },
          {
            h: 'Lingkup pekerjaan',
            isi: 'Lantai, dinding, atap, wallboard, wall panel, list profil, plafon, hingga penataan item dekorasi.',
          },
          {
            h: 'Hasil',
            isi: '2 ruang kerja privat dan 1 ruang meeting yang saling terhubung (connecting room).',
          },
        ].map((s) => (
          <div class="bg-concrete p-6">
            <h3 class="font-mono text-xs uppercase tracking-widest text-brass">{s.h}</h3>
            <p class="mt-3 text-sm text-graphite">{s.isi}</p>
          </div>
        ))}
      </div>

      <blockquote class="mt-10 max-w-3xl border-l-2 border-brass py-1 pl-6">
        <p class="text-lg text-graphite">
          &ldquo;Saya bisa pantau progresnya hari per hari, jadi tahu persis apa
          yang sedang dikerjakan. Hasil akhirnya sesuai dengan apa yang saya
          harapkan sejak awal.&rdquo;
        </p>
        <footer class="mt-4 font-mono text-xs uppercase tracking-widest text-graphite">
          — ERPS, klien Renovasi Ruang Kerja &amp; Meeting Room
        </footer>
      </blockquote>
    </div>
  </section>

  <!-- ══════════ PORTOFOLIO ══════════ -->
  <section id="portofolio-proyek" class="band border-t border-line">
    <div class="wrap">
      <p class="eyebrow">Portofolio proyek</p>

      <h2 class="text-3xl sm:text-4xl">Sebagian proyek yang telah kami kerjakan</h2>
      <p class="mt-5 max-w-2xl text-lg text-graphite">
        Dari ruang kantor swasta hingga fasilitas kampus dan instansi
        pemerintah — dikerjakan dengan standar kerja yang sama.
      </p>

      <div class="mt-10 grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
        {[
          {
            src: '/images/portfolio-parkregis.jpg',
            judul: 'Renovasi Interior Kantor — Park Regis by Prince Hotel',
            sub: 'Park Regis by Prince Hotel, Menteng',
          },
          {
            src: '/images/portfolio-mushola.jpg',
            judul: 'Mushola Fakultas Sains dan Teknologi UIN',
            sub: 'UIN Syarif Hidayatullah Jakarta',
          },
          {
            src: '/images/portfolio-senat.jpg',
            judul: 'Renovasi Ruang Senat UIN Jakarta',
            sub: 'UIN Syarif Hidayatullah Jakarta',
          },
          {
            src: '/images/portfolio-pusdiklat.jpg',
            judul: 'Renovasi Ruang Pusdiklat Kemenag',
            sub: 'Kementerian Agama Republik Indonesia',
          },
          {
            src: '/images/portfolio-dak.jpg',
            judul: 'Dak Interior Fakultas Kedokteran UIN',
            sub: 'UIN Syarif Hidayatullah Jakarta',
          },
          {
            src: '/images/portfolio-toilet.jpg',
            judul: 'Renovasi Toilet Fakultas Dakwah dan Komunikasi UIN',
            sub: 'UIN Syarif Hidayatullah Jakarta',
          },
          {
            src: '/images/portfolio-pagar.jpg',
            judul: 'Renovasi Pagar Fakultas Ilmu Kesehatan UIN',
            sub: 'UIN Syarif Hidayatullah Jakarta',
          },
        ].map((p) => (
          <figure class="bg-paper">
            <div class="aspect-[4/3] overflow-hidden">
              <img
                src={p.src}
                alt={p.judul}
                width="800"
                height="600"
                loading="lazy"
                class="h-full w-full object-cover"
              />
            </div>
            <figcaption class="p-5">
              <p class="font-mono text-xs uppercase tracking-widest text-brass">{p.sub}</p>
              <p class="mt-2 text-sm text-ink">{p.judul}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

